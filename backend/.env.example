# Copy to `.env` or use `.env.local` alongside it (both are loaded from `backend/`).
# Never commit real keys.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_CONFIGURED_KEY

# Optional — not required by the current Supabase client path
# DATABASE_URL=

# Browser origin(s) for CORS. Comma-separated for multiple URLs (e.g. Vercel prod + preview).
# Local dev: http://localhost:3000
# Production example: https://your-app.vercel.app,https://your-app-git-main-org.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Local model server (Ollama-compatible). Required for plan generation and support chat AI turns.
LOCAL_AI_BASE_URL=http://127.0.0.1:11434
LOCAL_AI_MODEL=phi4-mini
LOCAL_AI_TIMEOUT_SECONDS=60

# Optional: set to 1 to log raw vs sanitized chat replies at DEBUG (server logs only).
# CHAT_DEBUG_RAW=1
