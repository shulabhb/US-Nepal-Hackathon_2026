# Copy to `.env.local` for local development (never commit real secrets).
#
# Public API base for the FastAPI backend (browser-safe).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# Backend-only (set in `backend/.env`, NOT here):
#   SUPABASE_URL=...
#   SUPABASE_KEY=...          # service role or key with insert permission
#   FRONTEND_ORIGIN=http://localhost:3000
# Do not put SUPABASE service role keys or server secrets in the frontend.
