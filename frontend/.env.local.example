# Copy to `.env.local` for local development (never commit real secrets).
#
# Public API base for the FastAPI backend (browser-safe).
#
# Local dev (direct to API; requires backend CORS for localhost:3000):
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
#
# Remote demo via one ngrok tunnel to Next (see docs/tunnel.md) — same-origin proxy:
# NEXT_PUBLIC_API_BASE_URL=/burnout-api
#
# Vercel + Render (see docs/deployment.md) — same-origin proxy to hosted API:
# NEXT_PUBLIC_API_BASE_URL=/burnout-api
# BACKEND_PROXY_URL=https://your-service.onrender.com
#
# Optional: if FastAPI is not on 127.0.0.1:8000, set where Next should proxy (server-side only).
# BACKEND_PROXY_URL=http://127.0.0.1:8000
#
# Backend-only (set in `backend/.env`, NOT here):
#   SUPABASE_URL=...
#   SUPABASE_KEY=...          # service role or key with insert permission
#   FRONTEND_ORIGIN=http://localhost:3000
# Do not put SUPABASE service role keys or server secrets in the frontend.
